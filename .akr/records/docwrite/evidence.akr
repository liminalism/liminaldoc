record docwrite.evidence.autosave-off-path/1 : evidence {
    title "Typing does not create the bundle. Autosave writes it. Restoring the named snapshot drops the keystrokes that came after the snapshot."
    state verified
    result pass
    method command
    observed_at git:fe9fbbe24d9ea661363b36b90ce78b4e946416f9
    command "cargo test -p docwrite-app --test book_map typing_does_not_write_the_bundle_until_autosave"
    summary """
        Typing does not create the bundle. Autosave writes it. Restoring the named snapshot drops the keystrokes that came after the snapshot.
        """
}

