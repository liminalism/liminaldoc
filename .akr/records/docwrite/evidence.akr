        pending footnote carried across it.
        """
}

record docwrite.evidence.editor-commands/1 : evidence {
    title "The window's commands work: clipboard, undo, line motion across pages, click, save, autosave, export, CLI export"
    state verified
    result pass
    method command
    observed_at git:bffd54a79de1aeac643880dc02c48c95b33aa77c
    command "cargo test -p docwrite-app --test commands"
    summary """
        Four tests cover cut/copy/paste with undo/redo, Up/Down by typeset line across a
        page turn, click-to-caret, and open_or_create + save_now + background autosave +
        PDF/Markdown export + the headless 'lege-docwrite export' subcommand. The window
        was also launched on macOS against a demo bundle and screenshot: the opener shows
        its chapter title, the Book Map shows titles, and the page fills the view.
        """
}

record docwrite.evidence.editor-latency-release/1 : evidence {
    title "Typing through Editor into a 507-page book: one paragraph shaped, at most three pages laid out, p50 4.4 ms, max 4.9 ms (release)"
    state verified
    result pass
    method command
    observed_at git:bffd54a79de1aeac643880dc02c48c95b33aa77c
    command "cargo test --release -p docwrite-app --test latency_gate -- --nocapture"
    summary """
        typing_into_the_editor_stays_inside_the_budget types at the start, middle and end
        of a 507-page book through Editor::type_text + Editor::paint (1100x800). Every
        keystroke shaped exactly one paragraph and laid out at most three pages; wall
        clock p50 4.43 ms, max 4.95 ms against the 8 ms budget; opening the book 67 ms.
        Debug builds assert the work counts only.
        """
}

