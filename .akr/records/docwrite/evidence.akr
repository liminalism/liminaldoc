record docwrite.evidence.pdf-selection-copy-tests/1 : evidence {
    title "Working tree atop 291f3732: 122 reader library tests and 35 architecture tests passed, workspace all-target check passed. Generated 20-page PDF test drives the real conductor and pointer handlers, compares exact two-line copy text, checks highlight geometry, transfers keyboard focus from search, forces UI text eviction under memory pressure, revisits page zero and selects the same text again. Earlier regression runs failed on retained search focus and missing geometry on revisit. OS clipboard delivery is covered by existing external-backend tests, not a live desktop round-trip in this run."
    state verified
    result pass
    method command
    observed_at git:291f3732ffe2835f5cdeb7f5ba986d0542697fa0
    command "cargo test -p liminaldoc-reader --all-targets; cargo check --workspace --all-targets"
    summary """
        Working tree atop 291f3732: 122 reader library tests and 35 architecture tests passed, workspace all-target check passed. Generated 20-page PDF test drives the real conductor and pointer handlers, compares exact two-line copy text, checks highlight geometry, transfers keyboard focus from search, forces UI text eviction under memory pressure, revisits page zero and selects the same text again. Earlier regression runs failed on retained search focus and missing geometry on revisit. OS clipboard delivery is covered by existing external-backend tests, not a live desktop round-trip in this run.
        """
    author "dk"
}

record docwrite.evidence.pdf-startup-correctness/1 : evidence {
    title "Working tree atop 291f3732: 121 reader library tests and 35 architecture tests passed, all targets workspace check passed, reader clippy warnings denied passed, changed Rust files rustfmt and git diff --check clean. GPU-only+PDF and software-only+PDF all-target feature checks passed. No-default all-target check passed with pre-existing NeedsPassword dead-code warning; new software_start warning was fixed and GPU-only rerun clean. Eight before/after final and preview checksums identical, all 11 headless documents rendered with exit 0. Actual NVIDIA Vulkan promotion succeeded at 2322.897 ms after software exact content at 312.461 ms in a separate validation run; captured page visually correct. Independent reviewer final packet rs-d76f11e2e2b9 found no remaining must-fix issues."
    state verified
    result pass
    method command
    observed_at git:291f3732ffe2835f5cdeb7f5ba986d0542697fa0
    command "cargo test -p liminaldoc-reader --all-targets; cargo check --workspace --all-targets; cargo clippy -p liminaldoc-reader --all-targets --no-deps -- -D warnings"
    artifact ".agent/scratch/pdf-startup/headless-after.json"
    summary """
        Working tree atop 291f3732: 121 reader library tests and 35 architecture tests passed, all targets workspace check passed, reader clippy warnings denied passed, changed Rust files rustfmt and git diff --check clean. GPU-only+PDF and software-only+PDF all-target feature checks passed. No-default all-target check passed with pre-existing NeedsPassword dead-code warning; new software_start warning was fixed and GPU-only rerun clean. Eight before/after final and preview checksums identical, all 11 headless documents rendered with exit 0. Actual NVIDIA Vulkan promotion succeeded at 2322.897 ms after software exact content at 312.461 ms in a separate validation run; captured page visually correct. Independent reviewer final packet rs-d76f11e2e2b9 found no remaining must-fix issues.
        """
    author "dk"
}

record docwrite.evidence.pdf-startup-latency/1 : evidence {
    title "The measured final mean exact-visible latency is 277.663 ms across 33 launches of 11 PDFs, below the requested 300 ms average; median 217.516 ms. The 182 MB scanned book remains 535-592 ms because document metadata parsing alone takes roughly 400 ms. This is an average for the recorded local corpus and hardware, not a universal 300 ms per-document guarantee. Auto starts software, prepares shared GPU context in a worker, and promotes after a real fully covered frame; explicit GPU remains synchronous. Final release SHA256 2828c84111c7d1e904ff198b065d8c2268dfc2fc3f7e9f2123ee2b0c659a5550 installed to /home/dk/.local/bin/liminaldoc-reader with prior installed binary kept in scratch/pdf-startup/installed-reader-before."
    state superseded
    result pass
    method observation
    observed_at git:291f3732ffe2835f5cdeb7f5ba986d0542697fa0
    artifact ".agent/scratch/pdf-startup/gui-final-after.json"
    summary """
        The measured final mean exact-visible latency is 277.663 ms across 33 launches of 11 PDFs, below the requested 300 ms average; median 217.516 ms. The 182 MB scanned book remains 535-592 ms because document metadata parsing alone takes roughly 400 ms. This is an average for the recorded local corpus and hardware, not a universal 300 ms per-document guarantee. Auto starts software, prepares shared GPU context in a worker, and promotes after a real fully covered frame; explicit GPU remains synchronous. Final release SHA256 2828c84111c7d1e904ff198b065d8c2268dfc2fc3f7e9f2123ee2b0c659a5550 installed to /home/dk/.local/bin/liminaldoc-reader with prior installed binary kept in scratch/pdf-startup/installed-reader-before.
        """
    author "dk"
}

