record docwrite.evidence.writer-page-seek-latency/1 : evidence {
    title "Final optimized run on the working tree based on c1e92b1: all 3 latency tests passed. On a 550-page manuscript, seek/Page Up/Page Down plus buffer painting took median 1.374031 ms and maximum 1.501094 ms over 18 operations, with zero additional layout passes. The typing gate measured median 3.418249 ms and maximum 4.292147 ms; initial layout/paint took 107.453732 ms. These are in-process input-to-buffer timings, not physical display latency."
    state verified
    result pass
    method command
    observed_at git:c1e92b1a64922f7d058a1969b5b4d271922f3121
    command "cargo test --release -p docwrite-app --test latency_gate -- --nocapture"
    summary """
