akr 0.1
project lege-docwrite

record docwrite.work.djvu-reader/1 : work {
    title "DjVu reader backend behind document engine"
    state proposed
    intent """
        Add a DjVu reader backend after the common reader surface is host-independent.
        Keep the document descriptor, cancellation and worker contract format-neutral:
        normalize page geometry at the engine boundary and advertise optional text,
        outline, link and progressive-pass capabilities. Image-only pages must work
        without fabricated text artifacts. Preserve bounded worker and memory use
        when a PDF and DjVu document are both open. The current djvulibrust crate
        in Lege-ecosystem is an encoder, so identify a decoder and measure its
        licensing and performance before selecting it.
        """
    depends_on [ @docwrite.work.pdf-document-tab/1 ]
}

record docwrite.work.liminaldoc-native-menus/1 : work {
    title "Shared command registry and platform menu adapters"
    state proposed
    intent """
        Prepare one semantic command registry for Liminaldoc with stable command IDs,
        labels, accelerators, enabled and checked state, and dispatch against the
        active document surface. The same definitions should feed keyboard shortcuts,
        compact in-window controls, and future native menus. Separate manuscript
        Save (the editable .legebook) from Save As/Export of derivatives without
        duplicating file commands. Host-thread ownership must govern menu updates.

        Implement platform adapters later: macOS application and window menus via
        native APIs, a PixelKit-drawn menu for Linux with optional desktop
        integration, and a Windows adapter using winsafe where its API is suitable.
        The EvidenceIntake repository named by the user could not be inspected at
        this URL during scoping, so its approach is a lead to verify, not authority.
        No native menu integration is included in the extraction work.
        """
    note """
        User requested menu scoping in AKR only. Audit existing toolbar and tab-strip
        commands before adding menu UI; remove redundant routes while preserving
        keyboard access. Test active-tab command state, close/save flow, and
        accelerator conflicts on all three desktop platforms before implementation.
        """
}

record docwrite.work.m1-incremental-pagination/1 : work {
    title "Incremental pagination with convergence stop"
    state completed
    intent """
        Paginate forward from the edited paragraph until break positions match the cached layout; count laid-out pages for the convergence test.
        """
    part_of [ @docwrite.milestone.m1-editor-spike ]
}

record docwrite.work.m1-latency-gate/1 : work {
    title "Keypress-to-present instrumentation and regression gate"
    state completed
    intent """
        Port lege-viewer's FrameMetrics and input-trace replay; add a test that replays a typing trace against a 500-page document and fails over budget.
        """
    acceptance {
        check typing-trace {
            statement """
                Replaying page motion and keypresses on a 500-page document stays inside the 8ms budget, and each keypress lays out only the edited page and the next.
                """
            method command
            command "cargo test -p docwrite-app --test latency_gate"
            verified_by [ @docwrite.evidence.typing-trace/1 ]
        }
    }
    part_of [ @docwrite.milestone.m1-editor-spike ]
}

