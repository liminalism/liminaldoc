record docwrite.work.pdf-document-tab/1 : work {
    title "PDF document tab alongside manuscript tabs"
    state proposed
    intent """
        After the manuscript New/Open/Save and writing-ready paths are reliable, add a
        PDF tab alongside editable document tabs. A PDF tab keeps its own page position,
        zoom, search and selection, and routes keyboard, pointer, scroll and IME input
        only to the active surface. Reuse the Lege PDF engine and viewer behaviour by
        extracting a host-independent PDF view/controller; do not embed ViewerApp's
        separate winit event loop or treat a source pane as the PDF tab.
        """
    note """
        Extraction progress on 2026-09-24: the standalone Liminaldoc launcher
        routes PDF and manuscript formats to separate executables. The writer's
        native Open dialog now starts a reader window for PDF only when requested.
        This is an interim product route, not a PDF document tab. Cargo dependency
        trees confirm the launcher has no backend dependencies and the writer has
        no liminaldoc-reader dependency.

        For the mixed tab host, extract a host-independent reader surface that
        retains the existing conductor, tile, search, selection, zoom and
        navigation behavior. Own PDF state per tab and route input only to the
        active surface. Instantiate PDF workers, caches and presenter on first PDF
        use; opening a manuscript alone must not do so. Cover encrypted PDF,
        switching while rendering, tab close, and idle wake behavior before
        retiring the separate-window route. Preserve bounded workers and memory
        when multiple PDF tabs are open.
        """
}

record docwrite.work.spellcheck-optional/1 : work {
    title "Optional SymSpell spellchecking behind a feature flag"
    state proposed
    intent """
        Add optional, off-by-default spellchecking to the writer: SymSpell (symspell 0.5.x, MIT, pure Rust) behind a `spellcheck` cargo feature in a new docwrite-spell crate, run as a debounced per-paragraph background job that never touches the keypress-to-present path.
        """
    note """
        Scoped 2026-10-08 by a survey agent. Design: worker mirrors the background-save debounce (dirty BlockIds, 300ms+ idle); squiggles stored as derived per-block annotations painted as a decoration pass (theme gains squiggle color; zero layout impact); suggestions (lookup top-5) computed lazily when the popup opens. UI: default off, toolbar toggle, F7 check-next, Ctrl+. popup with <=5 suggestions + Add to dictionary, Esc dismisses, caret never moves. Dictionaries: SCOWL-derived en_US/en_GB frequency lists (~1MB each, permissive BSD-style grant + Ispell affix terms, attribution file carried), user words in spell-words.txt inside the bundle; SymSpell stock frequency_dictionary_en_82_765.txt acceptable. API sketch: SpellChecker::load(dict)->Result, check_paragraph(&str)->Vec<Misspelling>, suggest(&str, n)->Vec<Suggestion>, add_user_word(&str). Alternatives rejected: zspell (custom non-standard license, slower, Jun 2024), hunspell-rs bindings (C++ build fragility, 2022). Risks: SymSpell ASCII bias needs fold rules for diacritics; 0.5.x API churn (pin exact, wrap behind trait); deletion index tens of MB resident (stays behind the flag). Est. ~800-1000 LOC: new crate ~500-700 (dict/check/worker/types) + ~250 app (lib/view/commands/toolbar) + ~30 typeset decoration hook. Acceptance: latency gate unchanged with flag on; squiggle <=1s after pause; check+clippy clean default and --all-features; offline; license notices present. Sequence: crate+dict+unit tests, worker wiring, squiggle+toggle, popup+keys+user words, latency run+notices.
        """
    depends_on [ @docwrite.req.typing-latency/1 ]
    author "dk"
}

record docwrite.work.writer-200-page-exercise/1 : work {
    title "Exercise 200-page clipboard manuscript in the real writer"
    state completed
    intent """
        Exercise a real 200-page Lorem ipsum manuscript through the Liminaldoc
        window and clipboard with chapter starts every 30 pages. Retain the native
        bundle, verify saved/reopened content and physical chapter boundaries,
        inspect ordinary/fullscreen rendering and page navigation, and measure
        paste, typing, navigation and save behavior. Record observed failures and
        prioritized improvements with reproducible evidence.
        """
    acceptance {
        check exercise {
            statement """
                A retained 200-page native manuscript created through actual clipboard paste has seven chapters at 30-page intervals; live window checks and reproducible measurements identify observed issues and limitations.
                """
            method manual
            verified_by [ @docwrite.evidence.writer-200-page-exercise/1 ]
        }
    }
    implements [ @docwrite.req.minimal-writer-navigation/1, @docwrite.req.typing-latency/1 ]
    part_of [ @docwrite.milestone.m6-writer-ready/1 ]
    author "dk"
}

record docwrite.work.writer-autosave-interval/1 : work {
    title "Configurable background autosave every 15 to 120 minutes"
    state completed
    intent """
        Replace the 1.5-second idle autosave trigger with elapsed-time autosave at
        a user-selected interval of 15 through 120 whole minutes, default 15.
        Offer a minimal Ctrl/Cmd+Alt+S prompt and persist the application preference
        across launches. Apply it to every open native manuscript, including
        inactive tabs. Continued typing must not postpone the deadline; serialize
        and write through the existing background worker with no overlapping saves.
        Manual saves reset the schedule. New/imported documents need Save As to
        establish their native bundle destination; do not overwrite import sources.
        Retain failed-save dirty state and retry on the next interval.
        """
    acceptance {
        check autosave {
            statement """
                Intervals 15–120 minutes validate and persist, the prompt works in fullscreen, elapsed deadlines save dirty native manuscripts despite ongoing edits, clean/unnamed documents are skipped, and saves cannot overlap or discard edits made during saving. Failures remain recoverable.
                """
            method command
            command "cargo test -p docwrite-app"
            verified_by [ @docwrite.evidence.writer-autosave-interval/1 ]
        }
    }
    implements [ @docwrite.req.minimal-writer-navigation, @docwrite.req.typing-latency ]
    part_of [ @docwrite.milestone.m6-writer-ready ]
    author "dk"
}

record docwrite.work.writer-page-seek/1 : work {
    title "Seek by page number and keep long-book paging predictable"
    state completed
    intent """
        Add a compact Go to Page prompt on Ctrl/Cmd+G with physical page numbers,
        range validation, Enter to navigate and Escape to cancel. Retain fullscreen
        while seeking. Move the caret to editable text on the requested page so
        typing does not return to the old location. Keep Page Up/Down and search
        repeat available. Exercise cached navigation on a roughly 500-page book;
        add no new viewing mode or persistent toolbar control.
        """
    acceptance {
        check cached {
            statement """
                Page seek and Page Up/Down on a roughly 500-page manuscript reuse its existing layout; optimized navigation and paint are measured against the frame budget.
                """
            method command
            command "cargo test --release -p docwrite-app --test latency_gate -- --nocapture"
            verified_by [ @docwrite.evidence.writer-page-seek-latency/1 ]
        }
        check navigation {
            statement """
                Go to Page validates physical page numbers, preserves fullscreen and manuscript text, and places the caret on an editable destination. Page Up/Down and repeat search remain keyboard-accessible.
                """
            method command
            command "cargo test -p docwrite-app"
            verified_by [ @docwrite.evidence.writer-page-seek-behavior/1 ]
        }
    }
    implements [ @docwrite.req.exact-page-navigation, @docwrite.req.minimal-writer-navigation ]
    part_of [ @docwrite.milestone.m6-writer-ready ]
    author "dk"
}

record docwrite.work.writer-page-visibility/1 : work {
    title "Keep page content and page count visible during long-book navigation"
    state proposed
    intent """
        Address the long-manuscript exercise's two navigation visibility issues.
        Keep the existing physical Page Up/Down and page-seek semantics. Fit or
        bound fullscreen page scaling so a reader does not need extra scrolling
        to see text skipped between consecutive page-key views. Reserve room for
        the current/total page counter at every normal toolbar width, including
        row-wrap thresholds. Preserve the barebones appearance and cached layout;
        do not introduce viewing modes. Reuse the retained 200-page native book
        and live-window checks as acceptance evidence.
        """
    acceptance {
        check visible-pages {
            statement """
                At ordinary and high-DPI window sizes, physical page-key navigation does not hide intervening manuscript text below the viewport, and the current/total page count remains visible at toolbar wrap thresholds.
                """
            method manual
        }
    }
    derived_from [ @docwrite.observation.writer-200-page-exercise/1 ]
    implements [ @docwrite.req.minimal-writer-navigation/1 ]
    part_of [ @docwrite.milestone.m6-writer-ready/1 ]
    author "dk"
}

record docwrite.work.writer-prompt-editing/1 : work {
    title "Edit chapter names and search prompts with normal text controls"
    state completed
    intent """
        Continue M6 in-window drafting by making toolbar text prompts editable at
        the caret. Add grapheme-aware Left/Right, Home/End, Shift selection,
        Select All, Delete, and clipboard copy/cut/paste. Render the selection and
        keep the caret visible in long prompts. Route prompt input exclusively
        to the prompt, preserving manuscript text and the existing commit/cancel flow.
        """
    acceptance {
        check editing {
            statement """
                Chapter rename and search prompts support caret movement, selection, Unicode-safe deletion and replacement, clipboard editing, and visible long-input carets without changing manuscript text before commit.
                """
            method command
            command "cargo test -p docwrite-app"
            verified_by [ @docwrite.evidence.writer-prompt-editing/1 ]
        }
    }
    part_of [ @docwrite.milestone.m6-writer-ready ]
    author "dk"
}

record docwrite.work.writer-toolbar-wrap/1 : work {
    title "Keep writer commands reachable when the window narrows"
    state completed
    intent """
        Continue M6 window drafting by wrapping the existing toolbar controls when
        the window or UI scale leaves insufficient room for one row. Derive the
        page viewport and source-pane offset from the same toolbar geometry, keep
        pointer targets aligned with the labels, and preserve prompt and fullscreen
        behavior. This does not complete the manual M6 window-draft check.
        """
    acceptance {
        check reachable {
            statement """
                Every existing toolbar action remains visible and clickable at narrow and scaled window sizes; wrapped rows do not overlap pages or intercept prompt editing.
                """
            method command
            command "cargo test -p docwrite-app --test toolbar"
            verified_by [ @docwrite.evidence.writer-toolbar-wrap/1 ]
        }
