record docwrite.papercut.while-parsing-docx-xml-with-quick-xml-0-41-the/1 : papercut {
    title "While parsing DOCX XML with quick-xml 0.41, the first importer dropped…"
    state superseded
    statement """
        While parsing DOCX XML with quick-xml 0.41, the first importer dropped &amp; because entity references arrive as Event::GeneralRef rather than Event::Text; a fixture caught the loss and the parser now handles that event.
        """
    observed_at git:9ae0c209c55470707a55089a740488e1cbff4fea
    author "codex"
    created_at 2026-09-24
