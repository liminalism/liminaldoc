record docwrite.observation.pdf-write-gaps/3 : observation {
    title "lege-pdf-write lacks what typeset-book PDF output needs"
    state superseded
    statement """
        lege-pdf-write is still image-oriented and append-only: DocumentWriter needs the page count up front. Content operators are q, Q, g, cm, Do and the text set BT ET Tr Tc Tw Tz Tf Tm Tj TJ Ts; there are no path operators and fill is gray only. Fonts are Type0/Identity-H CIDFontType2 with FontFile2 only, no CFF/FontFile3. The writer embeds caller-supplied bytes and does not subset. ToUnicode is None, Identity, or a caller-supplied CMap. Several glyph fonts can be registered on the document. Image XObjects cover DCT, JPX, JBIG2, CCITT and indexed DeviceRGB; there is no Flate RGB image and no alpha channel. Outline bookmarks and metadata remain. The catalog can now carry /Lang, a /StructTreeRoot of element names, and /PageLabels. Link annotations and named destinations are still absent.
        """
    observed_at git:96bf831b69cadbdc71bb5e94d00f218e4d7e535d
    method manual
    watches [ "lege-pdf/write/src/**" ]
    supersedes [ @docwrite.observation.pdf-write-gaps/2 ]
}

record docwrite.observation.pdf-write-gaps/4 : observation {
    title "lege-pdf-write lacks what typeset-book PDF output needs"
    state superseded
    statement """
        lege-pdf-write now embeds several glyph-font banks per page (GlyphLine.font), each
        a caller-subset TrueType program with custom ToUnicode and widths, and draws gray
        filled rectangles (PdfPageArtifact.fills). Still missing for book output: CFF /
        FontFile3 embedding, general paths and RGB colour, link annotations and named
        destinations, and a real structure tree (set_structure writes a flat list).
        """
    observed_at git:6aa8fc0ab7799d8c9dbec6154b21b8e72f1768b6
    method manual
    watches [ "lege-pdf/write/src/**" ]
    supersedes [ @docwrite.observation.pdf-write-gaps/3 ]
}

